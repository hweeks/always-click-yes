{
  "jira": {
    "server": "jira",
    "mcp": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.atlassian.com/v1/sse"],
      "env": { "JIRA_API_TOKEN": "$JIRA_API_TOKEN" }
    },
    "projectKey": "ENG",
    "site": "https://your-org.atlassian.net"
  },
  "fleet": {
    "baseBranch": "main",
    "prCap": 4,
    "engineerModel": "sonnet",
    "engineerBudgetUSD": 15,
    "runBudgetUSD": 200,
    "deadmanHours": 24,
    "ticketCommit": "direct",
    "stackMode": "ask",
    "verifyCommands": ["go build ./...", "go test -race ./...", "gofmt -l .", "golangci-lint run ./..."],
    "verifyTimeoutSeconds": 900,
    "hosts": [
      {
        "name": "example-macos",
        "ssh": "you@mac.example.com",
        "repoPath": "/Users/you/proj",
        "acyBin": "/Users/you/bin/acy",
        "path": ["/opt/homebrew/bin", "/Users/you/.local/bin"],
        "rc": "~/.zshrc"
      },
      {
        "name": "example-linux",
        "ssh": "you@linux.example.com",
        "repoPath": "/home/you/proj",
        "acyBin": "/home/you/bin/acy",
        "path": ["/home/you/.local/bin"],
        "rc": "~/.bashrc",
        "shell": "bash"
      }
    ]
  }
}
