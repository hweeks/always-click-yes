{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // The extension host program, and only that: node types, no DOM. The tests
  // are excluded because they legitimately span both runtimes — they drive
  // webview/transport.ts directly — and tsconfig.test.json, which `npm test`
  // compiles them with, is the program that describes that. Nothing goes
  // unchecked; it is checked as what it is.
  "include": ["src"],
  "exclude": ["src/test"]
}
